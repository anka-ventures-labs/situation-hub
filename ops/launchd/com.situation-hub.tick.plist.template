<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.situation-hub.tick</string>
    <key>ProgramArguments</key>
    <array>
        <string>/absolute/path/to/.venv/bin/situation-hub</string>
        <string>tick</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>SITUATION_CONFIG</key>
        <string>/absolute/path/to/private/config.yaml</string>
    </dict>
    <key>StartInterval</key>
    <integer>60</integer>
</dict>
</plist>
